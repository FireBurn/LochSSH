#[m
# Network services, Internet style[m
#[m
# Note that it is presently the policy of I[m ANA to assign a single well-known[m
# port number for both TCP and UDP; hence, [m most entries here have two entries[m
# even if the protocol doesn't support UDP [m operations.[m
#[m
# Some References:[m
# http://www.iana.org/assignments/port-numb[m ers[m
# http://www.freebsd.org/cgi/cvsweb.cgi/src[m /etc/services[m
#[m
# Each line describes one service, and is o[m f the form:[m
# service-name  port/protocol  [aliases ...[m ]   [# comment][m
#[m
# See services(5) for more info.[m
#[m
[m
#[m
# IANA Assignments [Well Known Ports][m
# The Well Known Ports are assigned by the [m [7m/etc/services lines 1-21/1196 2%[27m[K[KIANA and on most systems can[m
# only be used by system (or root) processe[m s or by programs executed by[m
# privileged users.[m
# The range for assigned ports managed by t[m he IANA is 0-1023.[m
#[m
tcpmux          1/tcp                      [m         # TCP port service multiplexer[m
tcpmux          1/udp[m
compressnet     2/tcp                      [m         # Management Utility[m
compressnet     2/udp[m
compressnet     3/tcp                      [m         # Compression Process[m
compressnet     3/udp[m
rje             5/tcp                      [m         # Remote Job Entry[m
rje             5/udp[m
echo            7/tcp                      [m         # Echo[m
echo            7/udp[m
discard         9/tcp           sink null  [m         # Discard[m
discard         9/udp           sink null[m
systat          11/tcp          users      [m         # Active Users[m
systat          11/udp          users[m
